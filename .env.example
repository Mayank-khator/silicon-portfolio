# Never commit .env or real credentials. Public keys still require RLS.
# Root .env is read by Compose. Copy NEXT_PUBLIC_* values to apps/web/.env.local
# for Next.js direct builds; Next's project directory is apps/web.
NEXT_PUBLIC_DATA_MODE=demo
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_TELEMETRY_DISABLED=1

# In Docker, reach the CLI-managed local Supabase stack through host gateway.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_PUBLISHABLE_KEY=
# Secret, only supplied to private workers; NEVER use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RABBITMQ_USER=silicon
# Generate a random URL-safe password (no amqp URL reserved characters).
RABBITMQ_PASSWORD=
WEEKLY_REPORT_TARGETS={}
WEEKLY_REPORT_HOUR_UTC=8
ENABLE_LLM=false
LLM_PROVIDER=none
LLM_MODEL=
ALLOW_EXTERNAL_LLM=false
GROQ_API_KEY=
